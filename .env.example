# ============================================================
# DongkrakUsaha AI Marketing & SEO Publisher - Environment
# ============================================================
# Copy this file to .env and fill in the values.
# .env is git-ignored. Never commit real keys.
#
# KEY SLOT MODEL:
# Every AI worker (agent) has its own API key slot. A worker only ever reads
# its own slot -- it never falls back to another worker's key. This keeps one
# agent from draining the quota another agent depends on.
#
# You MAY point several slots at the same key value if you only have one key.
# The app tracks quota per (key x model) pair, so slots sharing a key correctly
# share that key's quota instead of each assuming a private allowance.
#
# A slot left empty means that agent is disabled: its route returns a clear
# configuration error naming the missing variable, instead of silently
# borrowing another key.
# ------------------------------------------------------------


# --- Gemini agent slots (create keys at https://aistudio.google.com/apikey) ---

# Orchestrator: master controller that talks to the user and routes work.
GEMINI_API_KEY_ORCHESTRATOR=""

# Campaign Strategy agent: positioning, offer framing, funnel direction.
GEMINI_API_KEY_STRATEGY=""

# SEO Keyword Strategy agent: keyword clusters, local search intent.
GEMINI_API_KEY_KEYWORD=""

# Content Generation agent: SEO title, meta description, body copy, CTA.
GEMINI_API_KEY_CONTENT=""

# Quality Control Audit agent: scoring, SEO checks, publishing readiness.
GEMINI_API_KEY_AUDIT=""

# Image Brief agent: visual concept + provider-ready prompt (text, not bitmap).
GEMINI_API_KEY_IMAGE=""

# Bitmap Image Renderer: the agent that actually produces the PNG/JPEG file
# (/api/image/generate). Kept in its own slot because image generation draws a
# different and much smaller free-tier allowance than text generation, so it must
# not compete with the Image Brief agent above.
GEMINI_API_KEY_BITMAP=""


# --- AI base-photo generation (optional) ---
# Generates the PHOTO UNDERNEATH a listing caption when you have no real product
# photo to upload. The caption itself is always drawn locally afterwards (image
# models cannot be trusted with exact Indonesian text), so this never produces the
# final listing image on its own. Both providers are optional; leave empty to keep
# the upload-only flow. Cloudflare is tried first, Hugging Face is the fallback.

# CLOUDFLARE (recommended: ~10,000 free Neurons/day, no credit card, roughly 170
# images/day). How to get both values, in the Cloudflare dashboard:
#   1. Sign up free at dash.cloudflare.com
#   2. Open the "Workers AI" page  ->  "Use REST API"
#   3. "Create a Workers AI API Token"  ->  "Create API Token"  ->  copy it (shown once)
#   4. On that same panel copy the "Account ID"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN_BITMAP=""

# HUGGING FACE (fallback only: free users get ~$0.10/month credit, roughly 30 images,
# and this model is billed through a third-party provider). Two steps, both required:
#   1. Create a token at https://huggingface.co/settings/tokens (fine-grained, with
#      "Make calls to Inference Providers" enabled)  ->  copy it (starts with hf_)
#   2. While logged in, open https://huggingface.co/black-forest-labs/FLUX.1-schnell
#      and click to accept its usage conditions -- the model is gated, calls fail otherwise
HUGGINGFACE_API_TOKEN_BITMAP=""


# --- Non-Gemini providers ---

# WebP conversion runs locally via sharp and needs no key.
# Only set this if a remote conversion fallback is ever configured.
WEBP_CONVERTER_API_KEY=""


# --- Application ---

# Public URL where this app is hosted. Optional for local development.
APP_URL=""

# Optional official DongkrakUsaha API key / bearer token.
# The current publishing flow uses the Chrome extension + browser session,
# not this API, so it can stay empty.
DONGKRAKUSAHA_API_KEY=""

# Optional DongkrakUsaha API / webhook endpoint. Unused by the extension flow.
DONGKRAKUSAHA_API_URL=""


# --- Deprecated ---
# GEMINI_API_KEY (global, single key) is NO LONGER USED.
# It was the Google AI Studio-era variable. The app now requires the per-agent
# slots above and will not fall back to a global key.
#
# OPENAI_API_KEY_IMAGE / OPENAI_IMAGE_MODEL are NO LONGER USED. Bitmap rendering
# was migrated from the OpenAI Images API to Gemini's own image models and now
# reads GEMINI_API_KEY_BITMAP.

# --- Welcome splash: developer's GitHub profile (optional) ---
# The splash shows this profile's README via GET /api/github/profile. Defaults to
# rasyagantar-lab. A token is only needed if the anonymous 60 req/h GitHub
# limit is ever hit (the server caches for 1 h, so normally it is not).
GITHUB_PROFILE_LOGIN=rasyagantar-lab
GITHUB_TOKEN=

# --- Persistence ---
# Where runtime data lives (campaigns, history, photos, agent logs). Leave all empty on
# a laptop = local disk. On Cloud Run / AI Studio the container disk is wiped on every
# restart, so the server switches to Firestore automatically there (K_SERVICE set).
# STORAGE_BACKEND forces a mode: local | gcs | firestore.
STORAGE_BACKEND=
# gcs mode only (standard project WITH billing; not available in AI Studio Starter Tier):
GCS_BUCKET=
GCS_LOCATION=asia-southeast2
# firestore mode (AI Studio Starter Tier). On AI Studio the project/database come from the
# firebase-applet-config.json its provisioning writes; set these only to override.
FIRESTORE_PROJECT=
FIRESTORE_DATABASE=
FIRESTORE_COLLECTION=du_storage
# Firebase WEB API key (identifies the project; Security Rules are the guard). Needed for the
# REST transport when the container's service account has no IAM on the Firestore project.
FIREBASE_API_KEY=
