{
  "manifest_version": 3,
  "name": "DongkrakUsaha SEO Publisher Assistant",
  "version": "1.3.0",
  "description": "Official Chrome Extension helper to inspect and publish listings directly into your DongkrakUsaha Member Dashboard.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.dongkrakusaha.com/*",
    "https://dongkrakusaha.com/*",
    "https://*.run.app/*",
    "https://*.asia-southeast1.run.app/*",
    "https://*.us-central1.run.app/*",
    "https://*.europe-west1.run.app/*",
    "https://*.ai.studio/*",
    "https://ai.studio/*",
    "https://*.googleusercontent.com/*",
    "https://*.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dongkrakusaha.com/*",
        "https://dongkrakusaha.com/*",
        "https://*.run.app/*",
        "https://*.asia-southeast1.run.app/*",
        "https://*.us-central1.run.app/*",
        "https://*.europe-west1.run.app/*",
        "https://*.ai.studio/*",
        "https://ai.studio/*",
        "https://*.googleusercontent.com/*",
        "https://*.google.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
