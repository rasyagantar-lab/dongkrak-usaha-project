{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx tests/lengthRule.test.ts && tsx tests/listingData.test.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.1.0",
    "@google-cloud/storage": "^8.1.0",
    "@google/genai": "^2.4.0",
    "@huggingface/inference": "^4.13.28",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "opentype.js": "^2.0.0",
    "playwright-chromium": "^1.62.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.4",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/opentype.js": "^1.3.10",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "allowScripts": {
    "@google/genai": true,
    "esbuild": true,
    "playwright-chromium@1.62.1": true,
    "protobufjs": true
  }
}
